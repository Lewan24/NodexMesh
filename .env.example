POSTGRES_DB=nodexmesh
POSTGRES_USER=nodexmesh_app
POSTGRES_PASSWORD=
JWT_KEY=
ADMIN_EMAIL=admin@nodexmesh.pl
ADMIN_PASSWORD=
# Optional SMTP override. Leave EMAIL_HOST empty to manage encrypted settings
# from Administration > Email. Email remains disabled by default.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=NodexMesh
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_USER_NOTIFICATIONS_ENABLED=true
EMAIL_ADMIN_ALERTS_ENABLED=true
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
ADMINER_PORT=8081

# Immediate NPM peer as seen by the frontend (use /32 or /128).
# For the shared-network example in docs/REVERSE_PROXY.md: 172.29.0.2/32
TRUSTED_EDGE_CIDR=127.0.0.1/32
RATE_LIMIT_IP_PER_MINUTE=2000
RATE_LIMIT_USER_PER_MINUTE=1000
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_REFRESH_PER_MINUTE=120
RATE_LIMIT_GATE_PER_MINUTE=10000
IP_PROTECTION_ENABLED=true
IP_PROTECTION_WINDOW_MINUTES=10
IP_PROTECTION_BAN_MINUTES=60
IP_FAILED_LOGIN_THRESHOLD=10
IP_UNAUTHORIZED_THRESHOLD=100
IP_NOT_FOUND_THRESHOLD=100
IP_BAN_ON_RATE_LIMIT=false
IP_RATE_LIMIT_THRESHOLD=100
# Exact public client IPv4/IPv6 addresses, not NPM/frontend addresses or CIDRs.
# Friendly IPs bypass bans and browsing/gate quotas; authentication limits remain.
FRIENDLY_IP_1=
FRIENDLY_IP_2=
