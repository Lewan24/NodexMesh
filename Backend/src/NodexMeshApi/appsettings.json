{
  "ConnectionStrings": {
    "__comment": "Set via ConnectionStrings__Default env var in deployment. SSL Mode=VerifyFull in production.",
    "Default": "Host=localhost;Port=5432;Database=nodexmesh;Username=nodexmesh_app;Password="
  },
  "Jwt": {
    "__comment": "Key is NEVER committed. Set via 'dotnet user-secrets set Jwt:Key \"...\"' or the Jwt__Key env var.",
    "Issuer": "https://localhost:5001",
    "Audience": "nodexmesh-web",
    "AccessTokenMinutes": 15
  },
  "Admin": {
    "Email": "admin@nodexmesh.pl",
    "Password": ""
  },
  "AppVersion": {
    "CurrentVersion": "v1.5.0",
    "LatestReleaseApiUrl": "https://api.github.com/repos/Lewan24/NodexMesh/releases/latest"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Library": {
    "Path": "App_Data/library",
    "MaxFileBytes": 52428800,
    "MaxProjectBytes": 1073741824
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Audit": {
    "SecurityRetentionDays": 180,
    "ActivityRetentionDays": 90,
    "DiagnosticRetentionDays": 30,
    "IncidentRetentionDays": 365,
    "WindowMinutes": 10,
    "FailedLoginThreshold": 5,
    "DistinctAccountsThreshold": 5,
    "DistinctIpsThreshold": 3,
    "ForbiddenThreshold": 10,
    "NotFoundThreshold": 20,
    "RateLimitThreshold": 10
  }
}
