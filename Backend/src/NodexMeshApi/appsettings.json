{
  "ConnectionStrings": {
    "__comment": "Set via ConnectionStrings__Default env var in deployment. SSL Mode=VerifyFull in production.",
    "Default": "Host=localhost;Port=5432;Database=nodexmesh;Username=nodexmesh_app;Password="
  },
  "Jwt": {
    "__comment": "Key is NEVER committed. Set via 'dotnet user-secrets set Jwt:Key \"...\"' or the Jwt__Key env var.",
    "Issuer": "https://localhost:5001",
    "Audience": "nodexmesh-web",
    "AccessTokenMinutes": 15
  },
  "Admin": {
    "Email": "admin@nodexmesh.pl",
    "Password": ""
  },
  "AppVersion": {
    "CurrentVersion": "v1.4.0",
    "LatestReleaseApiUrl": "https://api.github.com/repos/Lewan24/NodexMesh/releases/latest"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
