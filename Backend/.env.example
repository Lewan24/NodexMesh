# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Database ---
POSTGRES_DB=nodexmesh
POSTGRES_USER=nodexmesh_app
# Generate: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- JWT ---
# MUST be at least 32 characters. Generate: openssl rand -base64 48
# The API refuses to start if this is missing or too short.
JWT_KEY=
JWT_ISSUER=https://localhost:8080
JWT_AUDIENCE=nodexmesh-web
JWT_ACCESS_TOKEN_MINUTES=15

# --- App ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
# Where the SPA is served from. CORS denies everything not listed here.
FRONTEND_ORIGIN=http://localhost:5173
