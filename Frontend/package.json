{
  "imports": {
    "#/*": "./src/*"
  },
  "name": "nodexmesh",
  "private": true,
  "overrides": {
    "minimatch": "11.0.1"
  },
  "version": "1.13.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "benchmark:projection": "node scripts/benchmark-projection.mjs",
    "benchmark:canvas-model": "node scripts/benchmark-canvas-model.mjs",
    "build:performance": "vite build --config vite.performance.config.ts",
    "preview:performance": "vite preview --config vite.performance.config.ts --host 127.0.0.1 --port 4178 --strictPort",
    "test:browser": "playwright test",
    "benchmark:browser": "playwright test --grep \"profile pan\"",
    "benchmark:workspace": "playwright test workspace-performance --grep \"profile workspace\"",
    "typecheck:browser": "tsc --project tsconfig.browser.json",
    "build:guide": "vite build --config vite.guide.config.ts",
    "preview:guide": "vite preview --config vite.guide.config.ts --host 127.0.0.1 --port 4181 --strictPort",
    "guide:screenshots": "playwright test --config playwright.guide.config.ts",
    "guide:screenshots:workspace": "UPDATE_GUIDE_SCREENSHOTS=1 playwright test user-guide --grep 'capture workspace illustrations'"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/gloria-hallelujah": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/mansalva": "^5.3.0",
    "@fontsource/mynerve": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/patrick-hand-sc": "^5.3.0",
    "@fontsource/schoolbell": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@fontsource/short-stack": "^5.3.0",
    "@fontsource/walter-turncoat": "^5.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@xyflow/react": "^12.12.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.1",
    "highlight.js": "^11.12.0",
    "i18next": "^27.0.1",
    "lucide-react": "^1.70.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0",
    "react-router": "^8.5.1",
    "read-excel-file": "^9.3.14",
    "sonner": "2.0.8",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fontkit": "^2.0.4",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.77.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
